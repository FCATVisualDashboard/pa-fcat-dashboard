    completed: 18,
    approved: 3,
    unapproved: 2,
    overdue: 1,
  };
  const compliancePct = Math.round((complianceData.completed / complianceData.total) * 100);

  useEffect(() => {
    fetch(`${API_BASE_URL}/api/dashboard`)
      .then(res => res.json())
      .then(data => {
        setDashboardData(data);

        const map = new Map();
        if (data.cells) {
          data.cells.forEach(cell => {
            map.set(`${cell.x_pos},${cell.y_pos}`, cell);
          });
