  overflow: 'auto'          
}}>

      <div style={{
  backgroundColor: "#1a1a1a",
  borderBottom: "2px solid #eeff00",
  flexShrink: 0,
  height: "50px",
}}>
  <nav className="navbar" role="navigation">
    <div className="navbar-left">
      <a href="/">JFK FCAT PM Dashboard</a>
    </div>
    <div className="navbar-center">
      <ul>
        <li>
          <span className="navbar-stat">
